{
	"name": "craftassay",
	"version": "0.1.8",
	"private": false,
	"type": "module",
	"description": "Evidence-backed reviews of usefulness, clarity, quality, and presentation. An agent with the skill writes the report.",
	"license": "MIT",
	"author": "Catalyst Forge LLC",
	"keywords": [
		"review",
		"critique",
		"scorecard",
		"skill",
		"presentation",
		"comparison",
		"llm"
	],
	"homepage": "https://craftassay.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Catalyst-Forge-LLC/craftassay.git"
	},
	"bugs": {
		"url": "https://github.com/Catalyst-Forge-LLC/craftassay/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./skills/*": "./skills/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"skills",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"test": "tsc && node --test dist/index.test.js",
		"prepare": "tsc",
		"prepublishOnly": "tsc && pnpm test",
		"ship": "pnpm --dir site run ship",
		"site:dev": "pnpm --dir site dev",
		"site:build": "pnpm --dir site run build",
		"site:deploy": "pnpm --dir site run ship"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.30.1",
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2"
	}
}
